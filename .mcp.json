{
  "mcpServers": {
    "speechify": {
      "command": "uv",
      "args": [
        "run",
        "--with",
        "mcp>=1.2.0",
        "--with",
        "httpx>=0.27.0",
        "python",
        "mcp_servers/speechify/server.py"
      ],
      "env": {
        "SPEECHIFY_API_KEY": "${SPEECHIFY_API_KEY}"
      }
    }
  }
}
